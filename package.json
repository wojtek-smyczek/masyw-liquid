{
  "name": "masyw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "theme:css": "tailwindcss -i theme/src/tailwind.css -o theme/assets/theme.css --watch",
    "theme:build": "tailwindcss -i theme/src/tailwind.css -o theme/assets/theme.css --minify",
    "theme:check": "shopify theme check --path theme",
    "theme:dev": "shopify theme dev --path theme"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@shopify/cli": "^5.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.0.0"
  }
}
