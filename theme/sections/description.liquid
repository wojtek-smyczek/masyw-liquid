<section class="mt-0 flex h-full w-full pt-0">
  <h2 class="m-0 bg-white p-0 text-5xl text-black">{{ section.settings.text }}</h2>
</section>

{% schema %}
{
  "name": "Description",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "MASYW  create monolithic forms that do not merely occupy space they ground it. Solid. Heavy. Timeless. MASYW brings the monumental weight of nature into your interior, offering an immovable foundation in a world of constant flux. "
    }
  ],
  "presets": [{ "name": "Description" }]
}
{% endschema %}
