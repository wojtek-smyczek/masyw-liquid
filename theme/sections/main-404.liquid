<section class="flex min-h-screen w-full flex-col justify-center gap-3 bg-black px-3 pt-20 text-white">
  <h1 class="text-7xl">404</h1>
  <p class="text-2xl">{{ 'general.404.text' | t }}</p>
  <a
    href="{{ routes.root_url }}#products"
    class="link-masyw-desktop"
