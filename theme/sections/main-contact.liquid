{%- assign media_class = 'absolute inset-0 h-full w-full object-cover' -%}

<section class="flex min-h-screen flex-col bg-black pt-20 text-white md:flex-row md:pt-0">
  {%- comment -%} LEWA {%- endcomment -%}
  <div class="order-2 flex flex-col gap-1 md:order-1 md:flex-1">
    {%- for block in section.blocks -%}
      <div
        class="relative h-screen w-full"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag:
              class: media_class,
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 768px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: media_class }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} PRAWA {%- endcomment -%}
  <div class="relative order-1 flex w-full flex-col pb-10 pl-3 md:sticky md:top-0 md:order-2 md:h-screen md:flex-1">
    <div class="top-3 flex flex-col justify-center gap-3 md:h-screen">
      <h1 class="text-7xl">{{ section.settings.heading }}</h1>

      <div class="grid grid-cols-2">
        <span class="text-gray-500">MAIL</span>
        <span>{{ section.settings.mail }}</span>

        <span class="text-gray-500">PHONE</span>
        <span>{{ section.settings.phone }}</span>

        <span class="text-gray-500">IG</span>
        <span>{{ section.settings.instagram }}</span>
      </div>

      <div>
        <h2>{{ section.settings.form_heading }}</h2>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="text-green-500">{{ 'contact.form.success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="text-red-500">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <label for="ContactName">{{ 'contact.form.name' | t }}</label>
          <br>
          <input
            type="text"
            name="contact[name]"
            id="ContactName"
            class="border-white-100 w-full border-b p-1"
            placeholder="{{ 'contact.form.name_placeholder' | t }}"
            value="{{ form.name }}"
            autocomplete="name"
            required
          >

          <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
          <br>
          <input
            type="email"
            name="contact[email]"
            id="ContactEmail"
            class="border-white-100 w-full border-b p-1"
            placeholder="{{ 'contact.form.email_placeholder' | t }}"
            value="{{ form.email }}"
            autocomplete="email"
            required
          >

          <label for="ContactBody">{{ 'contact.form.message' | t }}</label>
          <br>
          <textarea
            name="contact[body]"
            id="ContactBody"
            class="border-white-100 w-full border-b p-1"
            placeholder="{{ 'contact.form.message_placeholder' | t }}"
            minlength="5"
            required
          >
            {{- form.body -}}
          </textarea>

          <button type="submit">
            <span>{{ 'contact.form.submit' | t }}</span>
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTACT" },
    { "type": "text", "id": "mail", "label": "Mail", "default": "hello@masyw-objects.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "48999111888" },
    { "type": "text", "id": "instagram", "label": "Instagram", "default": "@masyw_objects" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "CONTACT FORM" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ]
}
{% endschema %}
