<script src="{{ 'hero.js' | asset_url }}" defer></script>

<section class="relative flex h-screen w-full justify-center overflow-hidden">
  {%- liquid
    assign media_class = 'absolute inset-0 h-full w-full object-cover'
  -%}

  {%- if section.settings.video != blank -%}
    <masyw-video data-playback-rate="{{ section.settings.playback_rate }}">
      {{
        section.settings.video
        | video_tag:
          image_size: '1920x',
          autoplay: true,
          muted: true,
          loop: true,
          playsinline: true,
          controls: false,
          class: media_class
      }}
    </masyw-video>
  {%- elsif section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        class: media_class,
        widths: '800, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: media_class }}
  {%- endif -%}

  <div class="absolute top-20 w-full">
    <div class="animate-scroll">
      {%- for i in (1..3) -%}
        <span class="sliding-text-desktop">{{ section.settings.scrolling_text }}</span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "range",
      "id": "playback_rate",
      "label": "Video speed",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown when no video is selected."
    },
    {
      "type": "text",
      "id": "scrolling_text",
      "label": "Scrolling text",
      "default": "MASYW — Solid. Heavy. Timeless. — We create monolithic forms that ground space. — The monumental weight of nature. — "
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
