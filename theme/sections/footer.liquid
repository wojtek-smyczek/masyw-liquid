<footer class="w-full overflow-hidden bg-white pt-20">
  <div class="grid grid-cols-1 gap-1 md:grid-cols-3">
    {%- for block in section.blocks -%}
      <div class="flex flex-col" {{ block.shopify_attributes }}>
        <h3 class="product-masyw font-bold text-black">
          {{ block.settings.title }}
        </h3>
        <ul class="flex flex-col">
          {%- for i in (1..3) -%}
            {%- liquid
              assign label_key = 'link_' | append: i | append: '_label'
              assign url_key = 'link_' | append: i | append: '_url'
              assign label = block.settings[label_key]
              assign url = block.settings[url_key]
            -%}
            {%- if label != blank -%}
              <li class="product-masyw cursor-pointer">
                {%- if url != blank -%}
                  <a href="{{ url }}">{{ label }}</a>
                {%- else -%}
                  {{ label }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="w-full">
    <div class="animate-scroll overflow-hidden whitespace-nowrap">
      {%- for i in (1..3) -%}
        <span class="text-7xl font-black text-black uppercase">
          {{- section.settings.marquee_text -}}
        </span>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "contents",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Scrolling text",
      "default": "MASYW-MASYW-MASYW-MASYW-"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" }
      ]
    }
  ]
}
{% endschema %}
